{
    "parser": "@babel/eslint-parser",
    "parserOptions": {
        "requireConfigFile": false
    },
    "env": {
        "es6": true,
        "browser": true,
        "node": true
    },
    "extends": ["eslint:recommended", "google", "prettier"],
    "rules": {
        "require-jsdoc": "off"
        // "valid-jsdoc": "off"
    }
}
